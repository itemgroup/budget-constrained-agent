# LLM 配置：DeepSeek 或任意 OpenAI 兼容端点
# 也可以不写这里，直接在网页「LLM 与 RAG」卡片中填写（仅存进程内存）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# RAG 检索后端：auto（默认，kb_chroma/ 已建好则用 chroma，否则 tfidf）
#                tfidf（离线、零下载） / chroma（需 chromadb，索引存 kb_chroma/）
RAG_BACKEND=auto
